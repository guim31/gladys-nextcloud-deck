{
  "manifest_version": 1,
  "type": "device",
  "name": "Nextcloud Deck",
  "description": {
    "en": "Nextcloud Deck boards: cards due today and overdue, new and due cards, cards added from a scene.",
    "fr": "Tableaux Nextcloud Deck : cartes du jour et en retard, nouvelles cartes, ajout de cartes par scène.",
    "de": "Nextcloud-Deck-Boards: heute fällige und überfällige Karten, neue Karten, Karten aus Szenen.",
    "es": "Tableros de Nextcloud Deck: tarjetas de hoy y atrasadas, nuevas tarjetas, tarjetas desde escenas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-nextcloud-deck:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-nextcloud-deck/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Nextcloud",
        "fr": "Votre Nextcloud",
        "de": "Deine Nextcloud",
        "es": "Su Nextcloud"
      },
      "description": {
        "en": "A Nextcloud with the Deck app. Use an app password: Personal settings, Security, Devices & sessions, Create new app password.",
        "fr": "Un Nextcloud avec l'application Deck. Utilisez un mot de passe d'application : Paramètres personnels, Sécurité, Appareils & sessions, Créer un mot de passe d'application.",
        "de": "Eine Nextcloud mit der App Deck. Verwende ein App-Passwort: Persönliche Einstellungen, Sicherheit, Geräte & Sitzungen, Neues App-Passwort erstellen.",
        "es": "Un Nextcloud con la aplicación Deck. Use una contraseña de aplicación: Configuración personal, Seguridad, Dispositivos y sesiones, Crear nueva contraseña de aplicación."
      },
      "links": [
        {
          "url": "https://deck.readthedocs.io/en/latest/",
          "label": {
            "en": "Deck documentation",
            "fr": "Documentation de Deck",
            "de": "Deck-Dokumentation",
            "es": "Documentación de Deck"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "Address of Nextcloud, as in the browser, with https:// for HTTPS and its path if any (e.g. /nextcloud).",
        "fr": "Adresse de Nextcloud, comme dans le navigateur, avec https:// pour le HTTPS et son chemin s'il y en a un (ex. /nextcloud).",
        "de": "Adresse von Nextcloud wie im Browser, mit https:// für HTTPS und ihrem Pfad, falls vorhanden (z. B. /nextcloud).",
        "es": "Dirección de Nextcloud, como en el navegador, con https:// para HTTPS y su ruta si la hay (p. ej. /nextcloud)."
      },
      "placeholder": {
        "en": "e.g. https://cloud.example.org",
        "fr": "ex. https://cloud.example.org",
        "de": "z. B. https://cloud.example.org",
        "es": "p. ej. https://cloud.example.org"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username",
        "fr": "Identifiant",
        "de": "Benutzername",
        "es": "Usuario"
      },
      "description": {
        "en": "The Nextcloud login of the user whose boards are read.",
        "fr": "L'identifiant Nextcloud de l'utilisateur dont les tableaux sont lus.",
        "de": "Der Nextcloud-Benutzername des Benutzers, dessen Boards gelesen werden.",
        "es": "El usuario de Nextcloud cuyos tableros se leen."
      },
      "required": true,
      "default": ""
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "App password",
        "fr": "Mot de passe d'application",
        "de": "App-Passwort",
        "es": "Contraseña de aplicación"
      },
      "required": true,
      "description": {
        "en": "Recommended over the account password, required with two-factor login. Revocable at any time.",
        "fr": "Préférable au mot de passe du compte, obligatoire avec la connexion à deux facteurs. Révocable à tout moment.",
        "de": "Besser als das Kontopasswort, Pflicht bei Zwei-Faktor-Anmeldung. Jederzeit widerrufbar.",
        "es": "Preferible a la contraseña de la cuenta, obligatoria con el inicio de sesión de dos factores. Revocable en cualquier momento."
      }
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "boards",
      "type": "string",
      "label": {
        "en": "Followed boards",
        "fr": "Tableaux suivis",
        "de": "Verfolgte Boards",
        "es": "Tableros seguidos"
      },
      "description": {
        "en": "Names separated by commas. Empty: every board of the user (20 at most). One device per followed board.",
        "fr": "Noms séparés par des virgules. Vide : tous les tableaux de l'utilisateur (20 au plus). Un appareil par tableau suivi.",
        "de": "Namen durch Kommas getrennt. Leer: alle Boards des Benutzers (höchstens 20). Ein Gerät pro verfolgtem Board.",
        "es": "Nombres separados por comas. Vacío: todos los tableros del usuario (20 como máximo). Un dispositivo por tablero seguido."
      },
      "placeholder": {
        "en": "e.g. Home, Shopping",
        "fr": "ex. Maison, Courses",
        "de": "z. B. Haushalt, Einkauf",
        "es": "p. ej. Casa, Compras"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept self-signed certificates",
        "fr": "Accepter les certificats auto-signés",
        "de": "Selbstsignierte Zertifikate akzeptieren",
        "es": "Aceptar certificados autofirmados"
      },
      "description": {
        "en": "For an https:// address whose certificate is self-signed. Tick only for your own server.",
        "fr": "Pour une adresse en https:// dont le certificat est auto-signé. À cocher seulement pour votre propre serveur.",
        "de": "Für eine https://-Adresse mit selbstsigniertem Zertifikat. Nur für deinen eigenen Server aktivieren.",
        "es": "Para una dirección https:// con certificado autofirmado. Márquelo solo para su propio servidor."
      },
      "required": false,
      "default": false
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Deck is read (one request per board). Due dates and midnight are always followed on time.",
        "fr": "Fréquence de lecture de Deck (une requête par tableau). Les échéances et minuit sont toujours suivis à l'heure.",
        "de": "Wie oft Deck gelesen wird (eine Anfrage pro Board). Fälligkeiten und Mitternacht werden immer pünktlich verfolgt.",
        "es": "Frecuencia de lectura de Deck (una solicitud por tablero). Los vencimientos y la medianoche se siguen siempre a tiempo."
      },
      "required": false,
      "default": "300",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features when a device is added, and texts sent to scenes.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout d'un appareil, et textes envoyés aux scènes.",
        "de": "Namen der Funktionen beim Hinzufügen eines Geräts und an Szenen gesendete Texte.",
        "es": "Nombres dados a las funciones al añadir un dispositivo y textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads Deck now and reports what it finds.",
        "fr": "Lit Deck maintenant et indique ce qu'elle trouve.",
        "de": "Liest Deck jetzt und meldet, was gefunden wurde.",
        "es": "Lee Deck ahora e informa de lo que encuentra."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "card_created",
      "label": {
        "en": "New Deck card",
        "fr": "Nouvelle carte Deck",
        "de": "Neue Deck-Karte",
        "es": "Nueva tarjeta de Deck"
      },
      "description": {
        "en": "A card was created in a followed board (seen at the next reading).",
        "fr": "Une carte a été créée dans un tableau suivi (vue à la lecture suivante).",
        "de": "In einem verfolgten Board wurde eine Karte erstellt (beim nächsten Lesen erkannt).",
        "es": "Se creó una tarjeta en un tablero seguido (vista en la siguiente lectura)."
      },
      "fields": [
        {
          "key": "board",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Board (empty: any)",
            "fr": "Tableau (vide : tous)",
            "de": "Board (leer: alle)",
            "es": "Tablero (vacío: cualquiera)"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "List name (empty: any)",
            "fr": "Nom de la liste (vide : toutes)",
            "de": "Listenname (leer: alle)",
            "es": "Nombre de la lista (vacío: cualquiera)"
          },
          "description": {
            "en": "Exactly as written in Deck, e.g. Done.",
            "fr": "Exactement comme dans Deck, ex. Fait.",
            "de": "Genau wie in Deck, z. B. Erledigt.",
            "es": "Exactamente como en Deck, p. ej. Hecho."
          }
        }
      ],
      "variables": [
        {
          "key": "card",
          "type": "string",
          "label": {
            "en": "Card",
            "fr": "Carte",
            "de": "Karte",
            "es": "Tarjeta"
          }
        },
        {
          "key": "card_id",
          "type": "string",
          "label": {
            "en": "Card id",
            "fr": "Numéro de la carte",
            "de": "Karten-ID",
            "es": "Número de la tarjeta"
          }
        },
        {
          "key": "board_name",
          "type": "string",
          "label": {
            "en": "Board",
            "fr": "Tableau",
            "de": "Board",
            "es": "Tablero"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
