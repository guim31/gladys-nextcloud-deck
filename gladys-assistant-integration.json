  "scene_actions": [
    {
      "key": "add_card",
      "label": {
        "en": "Add a Deck card",
        "fr": "Ajouter une carte Deck",
        "de": "Deck-Karte hinzufügen",
        "es": "Añadir una tarjeta de Deck"
      },
      "description": {
        "en": "Adds a card at the bottom of a list, as the configured user.",
        "fr": "Ajoute une carte en bas d'une liste, au nom de l'utilisateur configuré.",
        "de": "Fügt eine Karte unten in einer Liste hinzu, als konfigurierter Benutzer.",
        "es": "Añade una tarjeta al final de una lista, como el usuario configurado."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "title",
          "type": "string",
          "required": true,
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "board",
          "type": "string",
          "label": {
            "en": "Board name (empty: the first one)",
            "fr": "Nom du tableau (vide : le premier)",
            "de": "Board-Name (leer: das erste)",
            "es": "Nombre del tablero (vacío: el primero)"
          }
        },
        {
          "key": "list",
          "type": "string",
          "label": {
            "en": "List name (empty: the first one)",
            "fr": "Nom de la liste (vide : la première)",
            "de": "Listenname (leer: die erste)",
            "es": "Nombre de la lista (vacío: la primera)"
          }
        },
        {
          "key": "due",
          "type": "string",
          "label": {
            "en": "Due date (optional)",
            "fr": "Échéance (facultative)",
            "de": "Fälligkeit (optional)",
            "es": "Vencimiento (opcional)"
          },
          "description": {
            "en": "2026-10-24 18:00, 2026-10-24 (noon), +2h, +3d. Time of Gladys.",
            "fr": "2026-10-24 18:00, 2026-10-24 (midi), +2h, +3d. Heure de Gladys.",
            "de": "2026-10-24 18:00, 2026-10-24 (Mittag), +2h, +3d. Uhrzeit von Gladys.",
            "es": "2026-10-24 18:00, 2026-10-24 (mediodía), +2h, +3d. Hora de Gladys."
          }
